# L4 层云端兜底配置 —— 复制为 .env 并填入任意一个可用 KEY
# 优先级：国内直连优先（dashscope / siliconflow），openai 需外网

IMAGE_PROVIDER=dashscope

# 阿里云百炼（通义万相），国内直连，约 0.1-0.2 元/张
DASHSCOPE_API_KEY=
DASHSCOPE_IMAGE_MODEL=wan2.5-t2i

# 硅基流动（Kolors / FLUX），国内直连
SILICONFLOW_API_KEY=
SILICONFLOW_IMAGE_MODEL=Kwai-Kolors/Kolors

# OpenAI images（需外网）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-1
