# PATHS.env.example — 路径模板
# 建库步骤：
#   cp PATHS.env.example PATHS.env    # PATHS.env 已被 .gitignore 排除，不会入库
#   改下面两行卷名，其余变量全部由它们派生，不用逐条改
#   scripts/check-paths.sh            # 复核
# 引用约定：启动脚本开头 `source "$(dirname "$0")/../PATHS.env"`，脚本内不再硬编码路径。
# 改路径只改这里。任何脚本里出现 /Volumes/... 字面量都是待清理的技术债。
# 版本：2026-11-04 v1（v2 索引优先方案 A2）

# ── 卷 ────────────────────────────────────────────────
export AIIL_VOL_SSD="/Volumes/<SSD卷名>"          # 外置 SSD，APFS ~328MB/s：权重 + 引擎
export AIIL_VOL_HDD="/Volumes/<HDD卷名>"            # 机械盘，~92MB/s：产物 + 项目 + 文档

# ── 逻辑根（唯一入口，一切从这里找）────────────────────
export AIIL_ROOT="$AIIL_VOL_HDD/work/projects/ai-image-lab"
export AIIL_DOCS="$AIIL_ROOT/docs"
export AIIL_WORKFLOWS="$AIIL_ROOT/workflows"
export AIIL_OUTPUTS="$AIIL_ROOT/outputs"
export AIIL_SCRIPTS="$AIIL_ROOT/scripts"

# ── 产物池（按来源分治，四个子目录）────────────────────
export AIIL_OUT_COMFY="$AIIL_OUTPUTS/comfyui"
export AIIL_OUT_DT="$AIIL_OUTPUTS/drawthings"
export AIIL_OUT_SD="$AIIL_OUTPUTS/sd-webui"
export AIIL_OUT_ARCHIVE="$AIIL_OUTPUTS/archive"

# ── 权重实体仓（全部在 SSD，只放不可重建物）────────────
export AIIL_WEIGHTS="$AIIL_VOL_SSD/ai-image-lab/models"
export AIIL_W_LEGACY_SD15="$AIIL_WEIGHTS/legacy-sd15"     # A1111 的 SD1.5 库（原 热数据/sd-webui-models）
export AIIL_W_DIFFUSION="$AIIL_WEIGHTS/diffusion_models"  # 新架构全量权重
export AIIL_W_TEXT_ENC="$AIIL_WEIGHTS/text_encoders"
export AIIL_W_UNET="$AIIL_WEIGHTS/unet"                   # GGUF 量化
export AIIL_W_VAE="$AIIL_WEIGHTS/vae"
export AIIL_W_DRAWTHINGS="$AIIL_WEIGHTS/drawthings"       # Draw Things 原生格式，7.3G，不可拆
export AIIL_W_LORAS="$AIIL_WEIGHTS/loras"
export AIIL_W_CONTROLNET="$AIIL_WEIGHTS/controlnet"
export AIIL_W_UPSCALE="$AIIL_WEIGHTS/upscale_models"
export AIIL_W_EMBEDDINGS="$AIIL_WEIGHTS/embeddings"
export AIIL_W_CLIP_VISION="$AIIL_WEIGHTS/clip_vision"
export AIIL_W_GGUF="$AIIL_WEIGHTS/gguf"
export AIIL_W_CHECKPOINTS="$AIIL_WEIGHTS/checkpoints"

# ── 引擎实体（各自原地不动，禁止迁移）──────────────────
# 禁忌：A1111 目录名与位置不可改（webui-user.sh 用 install_dir+clone_dir 拼接），
#       venv 内 41 个文件含绝对路径，动了就坏。
export AIIL_APP_SDWEBUI="$AIIL_VOL_HDD/work/projects/stable-diffusion-webui"
export AIIL_APP_COMFY="$AIIL_VOL_SSD/ai-image-lab/apps/ComfyUI"
export AIIL_APP_DT="$AIIL_VOL_SSD/ai-image-lab/apps/draw-things"

# ── 备份（只读基准，单向同步的源）──────────────────────
export AIIL_BACKUP_MODELS="$AIIL_VOL_HDD/work/data/models/sd-webui"

# ── 端口 ──────────────────────────────────────────────
export AIIL_PORT_COMFY=8188
export AIIL_PORT_SDWEBUI=7860

# ── 导出路径数组，供脚本遍历/校验 ──────────────────────
AIIL_ALL_PATHS=(
  "$AIIL_ROOT" "$AIIL_OUTPUTS" "$AIIL_WEIGHTS"
  "$AIIL_APP_SDWEBUI" "$AIIL_APP_COMFY" "$AIIL_APP_DT"
  "$AIIL_BACKUP_MODELS"
)
export AIIL_ALL_PATHS

# ── 软链索引映射（唯一真相源）──────────────────────────
# 格式："<仓库内相对链接路径>|<目标绝对路径>"
# 这 16 条软链是入库的索引条目（git 只存指向字符串），换机后由
# scripts/relink.sh 按本表批量重建，由 scripts/check-paths.sh 逐条校验。
# 增删模型子目录 = 同时改这里、PATHS.env 上方变量、磁盘实体三处。
AIIL_LINK_MAP=(
  "apps/comfyui|$AIIL_APP_COMFY"
  "apps/draw-things|$AIIL_APP_DT"
  "apps/sd-webui|$AIIL_APP_SDWEBUI"
  "models/checkpoints|$AIIL_W_CHECKPOINTS"
  "models/clip_vision|$AIIL_W_CLIP_VISION"
  "models/controlnet|$AIIL_W_CONTROLNET"
  "models/diffusion_models|$AIIL_W_DIFFUSION"
  "models/drawthings|$AIIL_W_DRAWTHINGS"
  "models/embeddings|$AIIL_W_EMBEDDINGS"
  "models/gguf|$AIIL_W_GGUF"
  "models/legacy-sd15|$AIIL_W_LEGACY_SD15"
  "models/loras|$AIIL_W_LORAS"
  "models/text_encoders|$AIIL_W_TEXT_ENC"
  "models/unet|$AIIL_W_UNET"
  "models/upscale_models|$AIIL_W_UPSCALE"
  "models/vae|$AIIL_W_VAE"
)
export AIIL_LINK_MAP
