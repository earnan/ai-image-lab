# ── macOS 系统文件 ──
.DS_Store
._*
.Spotlight-V100
.Trashes

# ── Python ──
__pycache__/
*.py[cod]
.venv/
venv/

# ── 机密：L4 云端 API KEY，只提交 .env.example ──
scripts/.env
.env
.env.local

# ── 运行产物：不入库 ──
# 30M 且持续增长，图片二进制无版本比对价值；可复现的是参数，而参数在
# workflows/ 与 scripts/ 里，已入库。目录语义见 outputs/README.md
outputs/**
!outputs/README.md

# ── 日志与临时 ──
*.log
logs/
_sdwebui-backup/
tmp/
temp/
*.tmp
*.pid

# ── 编辑器 ──
.vscode/
.idea/
*.swp

# ── 软链不入库：目标字符串即本机卷名与目录布局，入库等于公开磁盘结构 ──
# 指向关系收敛在 PATHS.env.example 的 AIIL_LINK_MAP，换机后 scripts/relink.sh 重建。
# 软链断了查 docs/runbook.md §排查 1，不要 cp 实体。
/apps/*
!/apps/README.md
/models/*
!/models/README.md

# ── 本机真实路径不入库，只提交模板 ──
PATHS.env
!PATHS.env.example
